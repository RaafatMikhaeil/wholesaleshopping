<div class="form_options">[ <a href="/notifications/notification">Create New Notification</a> ]</div>

<table class="notification_table">
	<tr>
    	<td colspan=5 class="top-header">Notification Manager</td>
    </tr>
    <tr>
        <td width="300" class="form-header">Message Preview</td>
        <td width="150" class="form-header">Created By</td>
