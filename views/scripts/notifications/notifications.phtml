    <tbody>
    	<?php $row = 0;
        if(Utility_Functions::canUserAccess("/notifications/notification")) $accessNotification = true;
        else $accessNotification = false;
        if(Utility_Functions::canUserAccess("/notifications/notificationassignments")) $accessNotificationAssignments = true;
        else $accessNotificationAssignments = false;
        if(Utility_Functions::canUserAccess("/notifications/notificationdeactivate")) $accessNotificationDeActivate = true;
        else $accessNotificationDeActivate = false;
        if(Utility_Functions::canUserAccess("/notifications/notificationactivate")) $accessNotificationActivate = true;
        else $accessNotificationActivate = false;
        foreach( $this->notifications as $notification ) { ?>
        	<tr class="row_<?php echo $row%2; ?>" id="<?php echo $notification['notification_id']; ?>">
            	<td><?php echo substr(strip_tags($notification['message']), 0, 50)."..."; ?></td>
                <td><?php echo $notification['name']; ?></td>
                <td><?php echo date("m/d/Y H:i:s", strtotime($notification['timestamp'])); ?></td>
                <td><?php echo ( $notification['is_active'] == 1 ) ? "Active":"Inactive"; ?></td>
                <td>
                	<?php if( $accessNotification ) { ?>
                        <a href="/notifications/notification/id/<?php echo $notification['notification_id']; ?>">
                            <img title="edit the selected notification's information" src="/images/icons/famfam/pencil.png" />
                        </a>
                    <?php } ?>
                    <?php if( $accessNotificationAssignments ) { ?>
                        <a href="/notifications/notificationassignments/id/<?php echo $notification['notification_id']; ?>">
                            <img title="assign groups to this notification" src="/images/icons/famfam/group_add.png" />
                        </a>
                    <?php } ?>
                    <?php if( $notification['is_active'] == 1 && $accessNotificationDeActivate ) { ?>
                        <a class="unit_deactivate" href="/notifications/notificationdeactivate/page/<?php echo $this->page; ?>/id/<?php echo $notification['notification_id']; ?>">
                            <img title="deactivate the selected notification" src="/images/icons/famfam/delete.png" />
                        </a>
                    <?php } else if ( $notification['is_active'] == 0 && $accessNotificationActivate ) { ?>
                        <a class="unit_activate" href="/notifications/notificationactivate/page/<?php echo $this->page; ?>/id/<?php echo $notification['notification_id']; ?>">
                            <img title="activate the selected notification" src="/images/icons/famfam/add.png" />
                        </a>
                    <?php } ?>
                </td>
            </tr>
            <?php ++$row; ?>
		<?php } ?>
	</tbody>
